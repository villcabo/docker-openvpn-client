# Path to your OpenVPN configuration file (.ovpn)
PATH_CONF=/path/file/config.ovpn

# Username for OpenVPN authentication
VPN_USERNAME=username

# Password for OpenVPN authentication
VPN_PASSWORD=password

# Name of the Docker container for the VPN client
CONTAINER_NAME=openvpn-client

# Subnets/hosts routed through the VPN container (read by manage.sh only).
# - One entry per line (or several per line, space-separated).
# - Text after `#` is a comment, so you can label each entry.
# - Accepted forms (IPv4 only):
#     10.0.0.0/16       whole /16 network (10.0.0.0 - 10.0.255.255)
#     192.168.10.0/24   one /24 segment (192.168.10.0 - 192.168.10.255)
#     172.20.40.64/27   a smaller block (32 addresses: .64 - .95)
#     192.168.1.42      a single host (same as 192.168.1.42/32)
# - Duplicates and stray commas are ignored; invalid entries and /0 (default
#   route) are skipped with a warning.
# - Avoid ranges that overlap your local LAN: manage.sh reports them as a
#   conflict instead of overriding the existing route.
SHARED_IPS="
    10.0.0.0/16         # Example: corporate network
    192.168.10.0/24     # Example: servers segment
    192.168.1.42        # Example: single host
"
